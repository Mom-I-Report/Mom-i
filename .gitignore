# ══════════════════════════════════════════════════════
#  Mom-i — 루트 .gitignore
# ══════════════════════════════════════════════════════

# ── 개인 메모 / 로컬 전용 ─────────────────────────────
docs/reference/claude-code-guide.md   # 개인 Claude Code 학습 노트

# ── OS ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~

# ── 환경변수 (절대 커밋 금지) ─────────────────────────
.env
backend/.env

# ── Python ────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ── Node / Vite ────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ── 로그 ──────────────────────────────────────────────
*.log

# ── 기타 ──────────────────────────────────────────────
*.tmp
*.bak
