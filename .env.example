# ── DB (docker-compose MariaDB 컨테이너) ──────────────────────────────────────
# 운영 환경에서는 강력한 랜덤 패스워드 사용 (openssl rand -base64 32)
DB_ROOT_PASSWORD=
DB_NAME=momi_db
DB_USER=momi_user
DB_PASSWORD=

# ── App ───────────────────────────────────────────────────────────────────────
PROJECT_NAME="맘아이 리포트 서버"

# Google AI Studio 또는 Google Cloud Console에서 발급
GEMINI_API_KEY=

# 로컬 직접 실행 시 (python run.py) — 도커 실행 시 docker-compose.yml이 자동 오버라이드
DATABASE_URL="mysql+pymysql://momi_user:패스워드@localhost:3306/momi_db"

# 맘아이 메인 서버와 공유하는 HS256 시크릿 (openssl rand -base64 64)
JWT_SECRET=

# 맘아이 서버 → 리포트 서버 호출 시 X-API-Key 헤더에 사용 (openssl rand -base64 32)
ADMIN_API_KEY=
