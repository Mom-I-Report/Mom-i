# ── DB (docker-compose MariaDB 컨테이너) ──────────────────────────────────────
DB_ROOT_PASSWORD="your_root_password_here"
DB_NAME="momi_db"
DB_USER="momi_user"
DB_PASSWORD="your_db_password_here"

# ── App ───────────────────────────────────────────────────────────────────────
PROJECT_NAME="맘아이 리포트 서버"

# Google AI Studio에서 발급 (필수)
GEMINI_API_KEY="your_google_gemini_api_key_here"

# 로컬 직접 실행 시 (python backend/run.py)
DATABASE_URL="mysql+pymysql://momi_user:your_db_password_here@localhost:3306/momi_db"

# 맘아이 메인 서버와 공유하는 JWT HS256 시크릿 (필수)
JWT_SECRET="your_jwt_secret_here"

# 맘아이 서버 → 리포트 서버 호출 시 X-API-Key 헤더에 사용 (필수)
ADMIN_API_KEY="your_admin_api_key_here"
